# =============================================
# Frontend .gitignore — React + Vite
# =============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Environment variables (never commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example file tracked
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vite cache
.vite/
