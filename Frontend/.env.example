# =================================================
# Frontend Environment Variables — RankQuest Platform
# =================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — only .env.example is tracked.

# Backend API base URL
# Local:      http://localhost:8080/api
# Production: https://your-render-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Google OAuth 2.0 Client ID
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Judge0 API Key (RapidAPI)
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
VITE_JUDGE0_API_KEY=your-judge0-rapidapi-key
