# =============================================
# ROOT .gitignore — RankQuest Platform DSA
# =============================================

# -----------------------------------------------
# Frontend (React + Vite)
# -----------------------------------------------
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/.env
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.test.local
Frontend/.env.production.local
Frontend/*.log
Frontend/.cache/

# -----------------------------------------------
# Backend (Spring Boot / Maven)
# -----------------------------------------------
Backend/target/
Backend/*.jar
Backend/*.war
Backend/*.ear
Backend/.env
Backend/HELP.md
Backend/.mvn/wrapper/maven-wrapper.jar

# -----------------------------------------------
# OS Files
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------
# IDE / Editor
# -----------------------------------------------
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------------------------------------
# Logs & Misc
# -----------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------
# Environment / Secrets (never commit these)
# -----------------------------------------------
.env
.env.*
!.env.example
!Frontend/.env.example
!Backend/.env.example
