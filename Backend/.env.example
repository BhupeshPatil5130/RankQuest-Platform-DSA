# =================================================
# Backend Environment Variables — RankQuest Platform
# =================================================
# Copy this file to .env OR set these as environment variables
# in your deployment platform (Render, Railway, etc.)
# NEVER commit .env — only .env.example is tracked.

# ── Server ──────────────────────────────────────
PORT=8080

# ── JWT ─────────────────────────────────────────
# Must be at least 256 bits (32+ chars). Use a long random string.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# ── Database (PostgreSQL for production) ────────
# Format: jdbc:postgresql://<host>:<port>/<dbname>
DATABASE_URL=jdbc:postgresql://localhost:5432/rankquest
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password

# ── Google OAuth ─────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://rankquest.vercel.app,https://www.rankquest.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
